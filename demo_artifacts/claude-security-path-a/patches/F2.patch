+    def test_upload_handler_receives_sanitized_file_name(self):
+        """
+        The file name handed to upload handlers has HTML entities decoded
+        before path components are removed, so an encoded separator cannot
+        reintroduce a path. Names for the current/parent directory are
+        skipped entirely.
+        """
+        received = {}
+
+        class RecordingUploadHandler(MemoryFileUploadHandler):
+            def new_file(self, field_name, file_name, *args, **kwargs):
+                received[field_name] = file_name
+                super().new_file(field_name, file_name, *args, **kwargs)
+
+        file_names = CANDIDATE_TRAVERSAL_FILE_NAMES + CANDIDATE_INVALID_FILE_NAMES
+        body = b''
+        for i, name in enumerate(file_names):
+            body += '\r\n'.join([
+                '--' + client.BOUNDARY,
+                'Content-Disposition: form-data; name="file%s"; filename="%s"' % (i, name),
+                'Content-Type: application/octet-stream',
+                '',
+                'You got pwnd.\r\n',
+            ]).encode()
+        body += ('\r\n--' + client.BOUNDARY + '--\r\n').encode()
+        parser = MultiPartParser({
+            'CONTENT_TYPE': client.MULTIPART_CONTENT,
+            'CONTENT_LENGTH': str(len(body)),
+        }, BytesIO(body), [RecordingUploadHandler()], 'utf-8')
+        _, files = parser.parse()
+        for i, name in enumerate(CANDIDATE_TRAVERSAL_FILE_NAMES):
+            with self.subTest(file_name=name):
+                self.assertEqual(received['file%s' % i], 'hax0rd.txt')
+                self.assertEqual(files['file%s' % i].name, 'hax0rd.txt')
+        offset = len(CANDIDATE_TRAVERSAL_FILE_NAMES)
+        for i, name in enumerate(CANDIDATE_INVALID_FILE_NAMES, start=offset):
+            with self.subTest(file_name=name):
+                self.assertNotIn('file%s' % i, received)
+                self.assertNotIn('file%s' % i, files)
+
