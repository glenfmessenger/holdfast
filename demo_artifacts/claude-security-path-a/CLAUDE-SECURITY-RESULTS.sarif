              "physicalLocation": {
                "artifactLocation": {
                  "uri": "django/http/multipartparser.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 217,
                  "snippet": {
                    "text": "                        file_name = self.IE_sanitize(html.unescape(file_name))"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "MultiPartParser.parse",
                  "fullyQualifiedName": "MultiPartParser.parse"
                }
              ]
            }
